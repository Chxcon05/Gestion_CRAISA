{
  "name": "@craisa/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:admin": "dotenv -e ../../.env -- tsx prisma/crear-admin.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@craisa/shared": "*",
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.7.8",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.14.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.10.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
