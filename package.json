{
  "name": "craisa-leads",
  "version": "2.0.0",
  "private": true,
  "description": "Prototipo de gestion y seguimiento de leads comerciales de CRAISA",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @craisa/api\" \"npm run dev -w @craisa/web\"",
    "build": "npm run build -w @craisa/web",
    "start": "npm run start -w @craisa/api",
    "lint": "oxlint apps packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @craisa/web",
    "test:todo": "npm run typecheck && npm run test && npm run test:e2e",
    "db:migrate": "npm run db:migrate -w @craisa/api",
    "db:seed": "npm run db:seed -w @craisa/api",
    "db:reset": "npm run db:reset -w @craisa/api"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.1.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
