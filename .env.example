# Copiar como .env en la raiz del repositorio.

# PostgreSQL 15+ (local o con docker compose up -d)
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/craisa_leads"

# Secreto para firmar la sesion. Minimo 16 caracteres en desarrollo y 32 en produccion.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Captura automatica de leads (formulario Contactenos del sitio web).
# Sin INGEST_WEB_SECRET la ruta /api/ingest/web responde 404. El mismo valor va en Vercel.
# INGEST_WEB_SECRET="generar-igual-que-JWT_SECRET-minimo-32-caracteres"
# Admin que recibe los leads automaticos; si falta, el primer administrador activo.
# INGEST_ASSIGNEE_EMAIL="admin@craisa.com"
# Linea de negocio inicial; se crea sola si no existe. El admin la corrige al reasignar.
# INGEST_BUSINESS_LINE="Sin clasificar"

# WhatsApp por Evolution API (el celular de la empresa se vincula por QR). Levantar con:
#   docker compose --profile whatsapp up -d evolution
# Clave inventada, minimo 16 caracteres: la usa Evolution para su panel y el API para mandar los avisos.
# Sin ella no se manda ningun aviso de asignacion por WhatsApp.
# EVOLUTION_API_KEY="generar-igual-que-JWT_SECRET"
# EVOLUTION_INSTANCE="atencion_cliente"
# EVOLUTION_URL="http://localhost:8080"
# Clave del webhook, minimo 32 caracteres; la misma va en el header x-ingest-key al configurar el webhook.
# Sin ella la ruta /api/ingest/whatsapp responde 404.
# EVOLUTION_WEBHOOK_SECRET="generar-igual-que-JWT_SECRET"
# Direccion de la web para el enlace al lead dentro del aviso.
# APP_URL="http://localhost:3000"

# Captura automatica desde el correo (info@craisa.com en Google Workspace).
# Cada correo nuevo de la bandeja de entrada crea un lead con canal Correo. El buzon se abre en solo
# lectura: no se marca nada como leido. Se ignoran boletines, respuestas automaticas y no-reply.
# La clave es una contrasena de aplicacion de Google (16 letras), no la clave normal de la cuenta:
# myaccount.google.com > Seguridad > Verificacion en dos pasos > Contrasenas de aplicaciones.
# MAIL_IMAP_USER="info@craisa.com"
# MAIL_IMAP_PASSWORD="abcd efgh ijkl mnop"
# Al activarla por primera vez se importan los correos de las ultimas MAIL_LOOKBACK_HOURS horas.
# MAIL_LOOKBACK_HOURS=48
# MAIL_POLL_SECONDS=60
# MAIL_IMAP_HOST="imap.gmail.com"

# Opcionales
# PORT=8081
# NODE_ENV=development
# TEST_DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/craisa_test"
