# Copiar como .env en la raiz del repositorio.

# PostgreSQL 15+ (local o con docker compose up -d)
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/craisa_leads"

# Secreto para firmar la sesion. Minimo 16 caracteres en desarrollo y 32 en produccion.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Captura automatica de leads (formulario Contactenos del sitio web).
# Sin INGEST_WEB_SECRET la ruta /api/ingest/web responde 404. El mismo valor va en Vercel.
# INGEST_WEB_SECRET="generar-igual-que-JWT_SECRET-minimo-32-caracteres"
# Admin que recibe los leads automaticos; si falta, el primer administrador activo.
# INGEST_ASSIGNEE_EMAIL="admin@craisa.com"
# Linea de negocio inicial; se crea sola si no existe. El admin la corrige al reasignar.
# INGEST_BUSINESS_LINE="Sin clasificar"

# Opcionales
# PORT=8081
# NODE_ENV=development
# TEST_DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/craisa_test"
